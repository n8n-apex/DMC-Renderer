"""Pattern for ST-09 — STATUS QUO (Plan B rebuild, grammar P-4).

DATA-PREP ONLY. This module reads the package `page` dict, resolves the
status-quo scene image URI, shapes a context dict, and renders
`templates/st_09.html.jinja` (which composes the atomic macro library on a
token-themed layout, `styles/st_09.css`). The returned PageFragment.html is that
rendered string; the .css is the layout sheet's contents.

WHY this shape (vs the old hand-built f-string CSS):
  - Brand-agnostic by construction: the template + layout CSS contain ZERO
    client literals (no hex, no font family, no client name). Colors + fonts
    arrive at render time via the token `:root` (compile_tokens) — the heading
    sizes off `var(--font-display)`, which resolves to the SERIF face when the
    brand's axis is headline_type=serif (the apex deck IS serif).
  - The device LOOK (numbered_block / callout_panel / media_figure / eyebrow)
    lives in the `c-` classes (components.css, already in the shared <head>);
    this pattern only feeds the macros DATA and positions them.

DATA CONTRACT (preserved from the prior pattern — fields on page["data"]):
  title, body (intro prose), symptoms[] (list of {title, body} dicts OR plain
  strings). Status-quo scene asset: page["assets"] entry with
  slot_id == "status_quo_scene" (or image_type == "scene").

The intro `body` is SPLIT for layout richness: the lead paragraphs become the
intro lede; the FINAL paragraph (the reassurance that the symptoms share one
fixable cause) becomes the closing tint insight panel (callout_panel). This is
graceful — a single-paragraph body stays as the intro with no panel; an empty
body yields neither.

The German kicker (STATUS QUO) and the callout label (Die gute Nachricht) are
CONTENT labels for this report TYPE (not client-specific) — module constants
passed to the template as data.

History (Plan B): replaced the prior monolithic f-string render (NUMBERED_BLOCK_CSS
from _components.py with hardcoded color + font-family literals) with this
data-prep → Jinja-template split. Earlier history documented in git.
"""

from __future__ import annotations

import sys
from pathlib import Path

# Allow flat imports from the chassis package.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from preprocess import preprocess_body  # noqa: E402
from templating import get_env  # noqa: E402
from patterns.base import PageFragment, RenderContext  # noqa: E402

# Layout CSS lives in a sibling sheet so it's auditable by the brand-agnostic
# guard (tokens only). Read once at import; returned verbatim as fragment.css.
_CSS_PATH = Path(__file__).resolve().parent.parent / "styles" / "st_09.css"
_CSS = _CSS_PATH.read_text(encoding="utf-8")

# Content labels for this report TYPE (not client-specific).
_KICKER = "Status quo"
_CALLOUT_LABEL = "Die gute Nachricht"

_SCENE_SLOT = "status_quo_scene"


def _split_intro(text: str) -> tuple[str, str]:
    """Split the intro prose into (lede_paragraphs, closing_paragraph).

    The closing paragraph (the reassurance) is peeled off for the callout panel
    when there are >=2 paragraphs; otherwise the whole body is the lede and the
    callout is empty. Paragraphs are double-newline separated (markdown).
    """
    paras = [p.strip() for p in (text or "").split("\n\n") if p.strip()]
    if len(paras) >= 2:
        return "\n\n".join(paras[:-1]), paras[-1]
    return ("\n\n".join(paras), "")


def render(page: dict, ctx: RenderContext) -> PageFragment:
    """Render the ST-09 status-quo page as a PageFragment.

    Data-prep → render templates/st_09.html.jinja. Head-level CSS lives in the
    shared head (assembler); this returns only the page body markup + the
    ST-09-scoped layout CSS.
    """
    d: dict = page.get("data") or {}

    # ---- status-quo scene from page assets (graceful: '' → no banner) ----
    scene_uri = ""
    for a in (page.get("assets") or []):
        if (a.get("slot_id") == _SCENE_SLOT or a.get("image_type") == "scene") and a.get("path"):
            p = ctx.resolve_asset(a["path"])
            if p is not None:
                scene_uri = p.as_uri()
            break

    # ---- intro split: lede paragraphs + a closing reassurance for the panel --
    lede_text, callout_text = _split_intro(d.get("body", ""))
    intro_html = preprocess_body(lede_text)
    callout_html = preprocess_body(callout_text)

    # ---- symptoms → numbered blocks (dicts {title, body} OR plain strings) ----
    symptoms: list[dict] = []
    for i, it in enumerate(d.get("symptoms") or [], start=1):
        if isinstance(it, dict):
            title, body = it.get("title", ""), it.get("body", "")
        else:
            title, body = "", str(it)
        symptoms.append({
            "n": i,
            "title": title,
            "body_html": preprocess_body(body),
        })

    diagram = d.get("diagram") if isinstance(d.get("diagram"), dict) else None

    # data-viz PRESET layer: data['viz'] is a list of {preset, …} specs the
    # curation step wrote (verbatim figures). Coerce to None unless a non-empty
    # list so the template renders exactly as before when absent (graceful). The
    # template renders the dispatch via the shared viz macro (ST-07A pattern).
    viz = d.get("viz")
    viz = viz if isinstance(viz, list) and viz else None

    template = get_env().get_template("st_09.html.jinja")
    html = template.render(
        kicker=_KICKER,
        title=d.get("title", ""),
        intro_html=intro_html,
        scene_uri=scene_uri,
        scene_alt=d.get("title", ""),
        symptoms=symptoms,
        callout_html=callout_html,
        callout_label=_CALLOUT_LABEL if callout_html else "",
        diagram=diagram,
        viz=viz,
    )
    return PageFragment(html=html, css=_CSS)
