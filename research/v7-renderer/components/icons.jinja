{# icon(key, uid) - the ONE entry point. Renders the glyph for `key`, or nothing
   at all when the key is unknown/empty. The svg carries aria-hidden: the icon is
   decorative reinforcement of a label that is always present as real text, so a
   screen reader (and the tagged PDF) reads the card's copy, not the glyph. #}
{% macro icon(key, uid=0) %}
{%- set geometry = ICON_PATHS.get(key) if key else none -%}
{%- if geometry -%}
<svg class="c-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ geometry }}</svg>
{%- endif -%}
{% endmacro %}
