# Copy to `.env` and fill in. Loaded locally via `uvicorn --env-file .env`.
# In production (Railway), set these in the platform's Variables UI instead —
# do NOT ship a .env inside the image.

# OpenRouter API key (secret). Used only as the Bearer token for the vision call.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Vision model slug (verified on OpenRouter). Swap here to change models.
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-4.6

# Model for the rich brand design brief (the "designer's eye"). Opus by default.
OPENROUTER_BRIEF_MODEL=anthropic/claude-opus-4.6

# fal.ai key (format: key_id:key_secret) for Stage 5 real image generation.
FAL_KEY=your-fal-key-id:your-fal-key-secret

# Stage 5 prompt-builder (per-image fal prompts) + fal image model + resolution.
OPENROUTER_PROMPT_MODEL=anthropic/claude-sonnet-4.6
FAL_IMAGE_MODEL=fal-ai/nano-banana-pro
FAL_IMAGE_RESOLUTION=2K

# n8n webhook the /onboard result is POSTed to (n8n persists it to Airtable).
REPORT_GENERATOR_WEBHOOK=https://n8n.zimmermannsysteme.de/webhook/report-generator

# Optional: where onboard writes screenshots + a fallback result file.
# Defaults to a fresh tempfile.mkdtemp(prefix="dmc_onboard_") if unset.
# ONBOARD_OUTPUT_DIR=/tmp/dmc_onboard
