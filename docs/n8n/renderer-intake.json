      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════════════════════\n// BUILD RENDER REQUEST — the RenderRequest the service expects\n// (research/preprocessor/models.py). ship=true → POST returns JSON now;\n// PDF+IDML arrive later at ship_webhook.\n// ═══════════════════════════════════════════════════════════\n\nconst record = $input.first().json;\nconst fields = record.fields || record;\n\nlet reportPayload;\ntry {\n  const raw = fields['report_json'] || fields.report_json;\n  reportPayload = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  throw new Error(`Failed to parse report_json: ${e.message}`);\n}\n\nlet imageManifest = { images: [] };\ntry {\n  const raw = fields['Image Manifest'] || fields.image_manifest;\n  const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n  if (parsed && Array.isArray(parsed.images)) imageManifest = parsed;\n} catch (e) {}\n\nconst client = fields['Client'] || fields.client || 'APEX Consulting';\nconst clientSlug = (fields['Client Slug'] || fields.client_slug ||\n  client.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''));\nconst recordId = record.id || '';\n\nreportPayload.meta = reportPayload.meta || {};\nreportPayload.meta.client_slug = clientSlug;\nreportPayload.meta.report_id = reportPayload.meta.report_id || recordId;\nif (!reportPayload.meta.page_count_target) reportPayload.meta.page_count_target = 20;\n\nconst hex = (v, fb) => (v && String(v).trim()) ? String(v).trim() : fb;\n\nconst request = {\n  record_id: recordId,\n  client: {\n    name: client,\n    company: fields['Company'] || fields.company || client,\n    website_url: fields['Website URL'] || fields.website_url || '',\n    brand_hex_dark: hex(fields['Brand Hex Dark'] || fields.brand_hex_dark, '#2E3E50'),\n    brand_hex_light: hex(fields['Brand Hex Light'] || fields.brand_hex_light, '#F6F3ED'),\n    brand_hex_accent: hex(fields['Brand Hex Accent'] || fields.brand_hex_accent, '#4A7C7E'),\n    founder_youtube_url: fields['Founder YouTube URL'] || fields.founder_youtube_url || null,\n    founder_instagram_url: fields['Founder Instagram URL'] || fields.founder_instagram_url || null\n  },\n  report_json: reportPayload,\n  image_manifest: imageManifest,\n  ship: true,\n  ship_webhook: 'https://n8n.zimmermannsysteme.de/webhook/renderer-output'\n    + '?record_id=' + encodeURIComponent(recordId)\n    + '&client_slug=' + encodeURIComponent(clientSlug)\n};\n\nreturn [{ json: {\n  render_request: request,\n  record_id: recordId,\n  client_slug: clientSlug,\n  page_count: reportPayload.meta.page_count_target,\n  image_count: (imageManifest.images || []).length,\n  cover_title: fields['Cover Title'] || ''\n}}];"
      },
