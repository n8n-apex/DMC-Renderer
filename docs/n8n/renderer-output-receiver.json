      "id": "o0000000-0001-4000-8000-000000000001",
      "name": "Renderer Output",
      "webhookId": "dmc-renderer-output",
      "notes": "Path MUST stay 'renderer-output' — it equals REPORT_GENERATOR_WEBHOOK. Receives multipart: binary pdf + idml, form field 'payload' = outcome JSON.",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// PARSE SHIP OUTCOME (multipart from renderer ship path)\nconst incoming = $input.first();\nconst body = incoming.json.body || {};\nlet outcome = {};\ntry {\n  outcome = typeof body.payload === 'string' ? JSON.parse(body.payload) : (body.payload || {});\n} catch (e) {\n  outcome = { parse_error: e.message };\n}\n\nreturn [{\n  json: {\n    record_id: (incoming.json.query && incoming.json.query.record_id) || '',\n    client_slug: (incoming.json.query && incoming.json.query.client_slug) || '',\n    status: outcome.status || 'unknown',\n    clear_ratio: outcome.clear_ratio ?? null,\n    pdf_name: (incoming.binary && incoming.binary.pdf && incoming.binary.pdf.fileName) || 'report.pdf',\n    idml_name: (incoming.binary && incoming.binary.idml && incoming.binary.idml.fileName) || 'report_indesign.zip',\n    punch_list: outcome.punch_list || []\n  },\n  binary: incoming.binary || {}\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        180
      ],
      "id": "o0000000-0002-4000-8000-000000000002",
      "name": "Parse Ship Outcome",
      "onError": "continueErrorOutput"
    },
    {
