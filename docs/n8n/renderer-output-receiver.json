        "jsCode": "const linkPdf = $('Drive: Upload PDF').item.json;\nconst linkIdml = $('Drive: Upload IDML').item.json;\nreturn [{\n  json: {\n    record_id: $('Parse Ship Outcome').item.json.record_id,\n    client_slug: $('Parse Ship Outcome').item.json.client_slug,\n    status: $('Parse Ship Outcome').item.json.status,\n    clear_ratio: $('Parse Ship Outcome').item.json.clear_ratio,\n    pdf_name: $('Parse Ship Outcome').item.json.pdf_name,\n    idml_name: $('Parse Ship Outcome').item.json.idml_name,\n    pdf_link: linkPdf.webViewLink || linkPdf.alternateLink || '',\n    idml_link: linkIdml.webViewLink || linkIdml.alternateLink || ''\n  }\n}];"
