    {
      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════════════════════════\n// PARSE SHIP OUTCOME — multipart from the renderer's ship path:\n//   binary: pdf (application/pdf), idml (application/zip)\n//   form field 'payload': JSON string of the ship outcome\n// ═══════════════════════════════════════════════════════════════\n\nconst incoming = $input.first();\nconst body = incoming.json.body || {};\nlet outcome = {};\ntry {\n  outcome = typeof body.payload === 'string' ? JSON.parse(body.payload) : (body.payload || {});\n} catch (e) {\n  outcome = { parse_error: e.message };\n}\n\nreturn [{\n  json: {\n    record_id: (incoming.json.query && incoming.json.query.record_id) || '',\n    client_slug: (incoming.json.query && incoming.json.query.client_slug) || '',\n    status: outcome.status || 'unknown',\n    clear_ratio: outcome.clear_ratio ?? null,\n    pdf_name: (incoming.binary && incoming.binary.pdf && incoming.binary.pdf.fileName) || 'report.pdf',\n    idml_name: (incoming.binary && incoming.binary.idml && incoming.binary.idml.fileName) || 'report_indesign.zip',\n    artifact_urls: outcome.artifact_urls || {},\n    punch_list: outcome.punch_list || []\n  },\n  binary: incoming.binary || {}\n}];"
      },
