      "parameters": {
        "jsCode": "// ═══════════════════════════════════════════════════════════════\n// BUILD RENDER REQUEST — the RenderRequest contract the service\n// actually expects (research/preprocessor/models.py::RenderRequest):\n//   { record_id, client{...brand hexes...}, report_json,\n//     image_manifest, ship: true, ship_webhook }\n// ship=true → POST /render returns the package JSON immediately;\n// the PDF+IDML arrive later as a multipart POST to ship_webhook.\n// ═══════════════════════════════════════════════════════════════\n\nconst record = $input.first().json;\nconst fields = record.fields || record;\n\n// ─── 1. report_json ───\nlet reportPayload;\ntry {\n  const raw = fields['report_json'] || fields.report_json;\n  reportPayload = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  throw new Error(`Failed to parse report_json: ${e.message}`);\n}\n\n// ─── 2. Image Manifest → { images: [...] } ───\nlet imageManifest = { images: [] };\ntry {\n  const raw = fields['Image Manifest'] || fields.image_manifest;\n  const parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n  if (parsed && Array.isArray(parsed.images)) imageManifest = parsed;\n} catch (e) {}\n\n// ─── 3. identity ───\nconst client = fields['Client'] || fields.client || 'APEX Consulting';\nconst clientSlug = (fields['Client Slug'] || fields.client_slug ||\n  client.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, ''));\nconst recordId = record.id;\n\n// meta guarantees (Stage 1 validates page_count_target in {16,20,24,28})\nreportPayload.meta = reportPayload.meta || {};\nreportPayload.meta.client_slug = clientSlug;\nreportPayload.meta.report_id = reportPayload.meta.report_id || recordId;\nif (!reportPayload.meta.page_count_target) reportPayload.meta.page_count_target = 20;\n\n// ─── 4. brand hexes (REQUIRED — 422 if missing). Apex defaults; override\n//        per-client via Airtable fields when onboarded. ───\nconst hex = (v, fb) => (v && String(v).trim()) ? String(v).trim() : fb;\nconst brandHexDark   = hex(fields['Brand Hex Dark']   || fields.brand_hex_dark,   '#2E3E50');\nconst brandHexLight  = hex(fields['Brand Hex Light']  || fields.brand_hex_light,  '#F6F3ED');\nconst brandHexAccent = hex(fields['Brand Hex Accent'] || fields.brand_hex_accent, '#4A7C7E');\n\n// ─── 5. assemble RenderRequest ───\nconst request = {\n  record_id: recordId,\n  client: {\n    name: client,\n    company: fields['Company'] || fields.company || client,\n    website_url: fields['Website URL'] || fields.website_url || '',\n    brand_hex_dark: brandHexDark,\n    brand_hex_light: brandHexLight,\n    brand_hex_accent: brandHexAccent,\n    founder_youtube_url: fields['Founder YouTube URL'] || fields.founder_youtube_url || null,\n    founder_instagram_url: fields['Founder Instagram URL'] || fields.founder_instagram_url || null\n  },\n  report_json: reportPayload,\n  image_manifest: imageManifest,\n  ship: true,\n  // The renderer POSTs the finished PDF+IDML here when done. The query\n  // params ride along so the receiver webhook knows which record this is.\n  ship_webhook: 'https://n8n.zimmermannsysteme.de/webhook/renderer-output'\n    + '?record_id=' + encodeURIComponent(recordId)\n    + '&client_slug=' + encodeURIComponent(clientSlug)\n};\n\nreturn [{\n  json: {\n    render_request: request,\n    record_id: recordId,\n    client: client,\n    client_slug: clientSlug,\n    cover_title: fields['Cover Title'] || fields.cover_title || '',\n    page_count: reportPayload.meta.page_count_target,\n    image_count: (imageManifest.images || []).length\n  }\n}];"
      },
